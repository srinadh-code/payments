# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Database ---
# Leave DATABASE_URL unset for local dev (SQLite is used automatically).
# On Render: attach a PostgreSQL instance and paste its "Internal Database
# URL" here (Render also injects it automatically as an env var if you wire
# it up via render.yaml — either way, this is the only DB setting needed).
DATABASE_URL=postgres://user:password@host:port/dbname

# --- Razorpay LIVE MODE keys ---
# Get these from the Razorpay Dashboard (after activating your account for
# live payments): Settings > API Keys > Generate Live Key.
# Paste the Key ID and Key Secret below exactly as shown by Razorpay.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=paste_your_live_key_secret_here

# Webhook secret is set by YOU when you create the webhook (it is not
# generated by Razorpay) — see Settings > Webhooks > Create Webhook.
# Use the exact same value here and in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=paste_the_webhook_secret_you_chose_here
